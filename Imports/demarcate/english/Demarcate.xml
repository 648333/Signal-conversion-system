    <Item Name="UpperFreqPrecision"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="true"
			  Description="Upper Limit Freq Index"
			  CanBatch="false"
			  Unified="false"
			  UnitName="dB"
			  Coefficient="1"
        SignalSource="Agilent"
        Multimeter="true"
			  Handler="DHDAS.Demarcate.UpperFreq.UpperFrequenceHelper,DemarcateLib"/>

    <Item Name="LowerFreqPrecision"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="false"
			  Flatness="false"
			  Configurable="true"
			  Unified="false"
			  Description="Lower Cutoff Freq Index"
