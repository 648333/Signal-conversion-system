			  UnitName="dB"
			  Coefficient="1"
        SignalSource="Agilent"
        Multimeter="true"
			  Handler="DHDAS.Demarcate.LowerFreqPrecision.LowerFreqHelper,DemarcateLib"/>

    <Item Name="FrequenceResponse"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA|MEASURE_HEAT_FLOW|MEASURE_PRESSURE_TEST"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="false"
			  Flatness="false"
			  Configurable="true"
			  Unified="true"
			  Description="Freq Response Calibration"
			  CanBatch="false"
