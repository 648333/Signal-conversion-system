        Multimeter="true"
			  Handler="DHDAS.Demarcate.FreqResponse.FrequenceResponseHelper,DemarcateLib"/>

    <Item Name="LowerFilter"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="false"
			  Flatness="false"
			  Configurable="true"
			  Unified="false"
			  Description="Low-pass Filter Performance Index"
			  CanBatch="true"
			  UnitName="dB"
