<?xml version="1.0" encoding="gb2312" ?>
<Demarcate>
  <Items>
    <Item Name="StrainValue"
			  MeasureType="MEASURE_TYPE_STRAINMETER|MEASURE_TYPE_TTC_STRAIN"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="true"
			  Description=" Strain Indication Error Calibration"
			  CanBatch="false"
			  ShowParameter="true"
			  SupportRevise="false"
        AbsolutePrecisionEnabled="true"
			  UnitName="%"
        EU ="με"
			  Coefficient="0.01"
        SignalSource="DH43018"
			  Handler="DHDAS.Demarcate.StrainValue.StrainValueHelper,DemarcateLib"/>

    <Item Name="StrainNonlinear"
			  MeasureType="MEASURE_TYPE_STRAINMETER"
			  Average="50"
			  Delay="1000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="false"
			  CanBatch="false"
			  Description="Strain Nolinear Error"
			  UnitName="%"
        Coefficient="0.01"
        SignalSource="DH43018"
			  Handler="DHDAS.Demarcate.StrainNonlinear.StrainNonlinearHelper,DemarcateLib"/>

    <Item Name="StrainZeroExcursion"
			  MeasureType="MEASURE_TYPE_STRAINMETER"
			  Average="100"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="true"
			  CanBatch="true"
			  Description="Strain Zero Drift"
        UnitName="με"
        SignalSource="DH43018|Unknown"
			  Coefficient="1"
			  Handler="DHDAS.Demarcate.StrainZero.StrainZeroHelper,DemarcateLib"/>

    <Item Name="StrainValueStability"
			  MeasureType="MEASURE_TYPE_STRAINMETER"
			  Average="50"
			  Delay="1000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="false"
			  Description="Strain Indication Stability"
			  UnitName="%"
			  Coefficient="0.01"
			  CanBatch="false"
        SignalSource="DH43018"
			  Handler="DHDAS.Demarcate.StrainValueStability.StabilityHelper,DemarcateLib"/>

