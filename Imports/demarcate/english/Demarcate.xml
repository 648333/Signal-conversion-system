    <Item Name="VoltageValue"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA|MEASURE_HEAT_FLOW|MEASURE_PRESSURE_TEST|MEASURE_TYPE_TTC_VOLTAGE"
			  Average="50"
			  Delay="5000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="true"
			  Description="Voltage Indication Error"
			  CanBatch="true"
			  HorizontalGrid="true"
			  ShowParameter="true"
			  EnableSwitchDirection="true"
        UnitName="%"
        EU ="mV"
			  Coefficient="0.01"
			  Opsonic="true"
        WaitSwitch="false"
        SignalSource="DH43018|DH43019|Agilent|Unknown"
			  Handler="DHDAS.Demarcate.VoltageValueError.VoltageValueErrorHelper,DemarcateLib"/>

    <Item Name="VoltageNonlinear"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA|MEASURE_HEAT_FLOW|MEASURE_PRESSURE_TEST"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="false"
			  Description="Voltage Nolinear Error"
			  CanBatch="true"
			  HorizontalGrid="true"
			  ShowParameter="true"
			  EnableSwitchDirection="true"
			  UnitName="%"
			  Coefficient="0.01"
			  Opsonic="true"
        SignalSource="DH43019|Agilent|Unknown"
			  Handler="DHDAS.Demarcate.VoltageNonlinear.NonlinearHelper,DemarcateLib"/>

    <Item Name="VoltageZeroExcursion"
          MeasureType="MEASURE_TYPE_INTERNAL_DA|MEASURE_HEAT_FLOW|MEASURE_PRESSURE_TEST"
          Average="100"
          ShowZero="true"
          Flatness="false"
          Configurable="true"
          CanBatch="true"
          Description="Voltage Zero Drift"
          UnitName="mV"
          Coefficient="1"
          SignalSource="DH43019|Agilent|Unknown"
          Handler="DHDAS.Demarcate.VoltageZero.VoltageZeroHelper,DemarcateLib"/>
