    <Item Name="SensorMagLinear"
          MeasureType="MEASURE_TYPE_INTERNAL_DA|MEASURE_TYPE_SENSOR_PE"
          Description="Senstivity Linearity Calibration"
          ShowParameter="true"
          UnitName="%"
          Coefficient="1"
          SignalSource="Agilent"
          SetupChannel="true"
          Handler="DHDAS.Demarcate.SensorValueLinear.MagLinearHelper,DemarcateLib"/>      
   
