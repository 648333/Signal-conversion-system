        SignalSource="Agilent"
        Multimeter="true"
			  Handler="DHDAS.Demarcate.LowerFilter.LowerFilterHelper,DemarcateLib"/>

    <Item Name="AntiConfusionFilter"
			  MeasureType="MEASURE_TYPE_INTERNAL_DA"
			  Average="50"
