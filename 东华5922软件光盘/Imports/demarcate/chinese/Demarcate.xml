    <Item Name="StrainValue"
			  MeasureType="MEASURE_TYPE_STRAINMETER|MEASURE_TYPE_TTC_STRAIN"
			  Average="50"
			  Delay="3000"
			  Ratio="0.2"
			  ShowZero="true"
			  Flatness="false"
			  Configurable="true"
			  Description="应变示值误差校准"
			  CanBatch="false"
			  ShowParameter="true"
			  SupportRevise="false"
        AbsolutePrecisionEnabled="true"
			  UnitName="%"
        EU ="με"
			  Coefficient="0.01"
        SignalSource="DH43018"
        SetupChannel="false"
			  Handler="DHDAS.Demarcate.StrainValue.StrainValueHelper,DemarcateLib"/>

    <Item Name="StrainNonlinear"
