<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>DH.Shell</RootNamespace>
    <AssemblyName>DHDAS</AssemblyName>
    <Version>1.0.0</Version>
    <Company>DH-RTDAS</Company>
    <Product>DH-RTDAS Shell</Product>
    <Description>主框架：主窗口、Ribbon菜单、Docking布局、插件加载器</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DH.Core\DH.Core.csproj" />
    <ProjectReference Include="..\DH.Hardware.Abstractions\DH.Hardware.Abstractions.csproj" />
    <ProjectReference Include="..\DH.Channels\DH.Channels.csproj" />
    <ProjectReference Include="..\DH.Acquisition\DH.Acquisition.csproj" />
    <ProjectReference Include="..\DH.Visualization.Core\DH.Visualization.Core.csproj" />
    <ProjectReference Include="..\DH.SignalProcessing.Core\DH.SignalProcessing.Core.csproj" />
  </ItemGroup>

</Project>
