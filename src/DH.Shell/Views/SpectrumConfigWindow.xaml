<Window x:Class="DH.Shell.Views.SpectrumConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="频谱分析设置" Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="BorderBrush" Value="#4A4A5A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="BorderBrush" Value="#4A4A5A"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B5C8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="BorderBrush" Value="#4A4A5A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#2B5C8A"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="TickFrequency" Value="10"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 基本设置 -->
        <GroupBox Header="基本设置" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="分析通道:"/>
                <ComboBox x:Name="ChannelCombo" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="频谱类型:"/>
                <ComboBox x:Name="SpectrumTypeCombo" Grid.Row="0" Grid.Column="3" Margin="0,4">
                    <ComboBoxItem Content="幅值谱" Tag="Magnitude"/>
                    <ComboBoxItem Content="功率谱" Tag="Power"/>
                    <ComboBoxItem Content="功率谱密度" Tag="PSD"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="窗函数:"/>
                <ComboBox x:Name="WindowCombo" Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <ComboBoxItem Content="汉宁窗 (Hanning)" Tag="Hanning"/>
                    <ComboBoxItem Content="汉明窗 (Hamming)" Tag="Hamming"/>
                    <ComboBoxItem Content="布莱克曼窗 (Blackman)" Tag="Blackman"/>
                    <ComboBoxItem Content="布莱克曼-哈里斯 (BlackmanHarris)" Tag="BlackmanHarris"/>
                    <ComboBoxItem Content="平顶窗 (FlatTop)" Tag="FlatTop"/>
                    <ComboBoxItem Content="矩形窗 (Rectangle)" Tag="Rectangle"/>
                    <ComboBoxItem Content="三角窗 (Triangle)" Tag="Triangle"/>
                    <ComboBoxItem Content="凯泽窗 (Kaiser)" Tag="Kaiser"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="FFT点数:"/>
                <ComboBox x:Name="FftSizeCombo" Grid.Row="1" Grid.Column="3" Margin="0,4">
                    <ComboBoxItem Content="256" Tag="256"/>
                    <ComboBoxItem Content="512" Tag="512"/>
                    <ComboBoxItem Content="1024" Tag="1024"/>
                    <ComboBoxItem Content="2048" Tag="2048"/>
                    <ComboBoxItem Content="4096" Tag="4096"/>
                    <ComboBoxItem Content="8192" Tag="8192"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="平均次数:"/>
                <ComboBox x:Name="AverageCombo" Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <ComboBoxItem Content="不平均" Tag="0"/>
                    <ComboBoxItem Content="2次" Tag="2"/>
                    <ComboBoxItem Content="4次" Tag="4"/>
                    <ComboBoxItem Content="8次" Tag="8"/>
                    <ComboBoxItem Content="16次" Tag="16"/>
                    <ComboBoxItem Content="32次" Tag="32"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="平均方式:"/>
                <ComboBox x:Name="AverageTypeCombo" Grid.Row="2" Grid.Column="3" Margin="0,4">
                    <ComboBoxItem Content="线性平均" Tag="Linear"/>
                    <ComboBoxItem Content="指数平均" Tag="Exponential"/>
                    <ComboBoxItem Content="峰值保持" Tag="PeakHold"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- 显示设置 -->
        <GroupBox Header="显示设置" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="LogYCheck" Grid.Row="0" Grid.Column="0" Content="对数Y轴" IsChecked="True"/>
                <CheckBox x:Name="LogXCheck" Grid.Row="0" Grid.Column="1" Content="对数X轴"/>
                <CheckBox x:Name="ShowPeaksCheck" Grid.Row="0" Grid.Column="2" Content="显示峰值" IsChecked="True"/>
                <CheckBox x:Name="ShowGridCheck" Grid.Row="0" Grid.Column="3" Content="显示网格" IsChecked="True"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y轴范围:"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="YMinText" Width="60" Text="-120"/>
                    <TextBlock Text=" ~ " Margin="4,0"/>
                    <TextBox x:Name="YMaxText" Width="60" Text="10"/>
                    <TextBlock Text=" dB" Margin="4,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="频率范围:"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                    <TextBox x:Name="FreqMaxText" Width="60" Text="500"/>
                    <TextBlock Text=" Hz" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 光标设置 -->
        <GroupBox Header="光标测量" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="CursorCheck" Grid.Row="0" Grid.Column="0" Content="启用频率光标"
                          Checked="CursorCheck_Checked" Unchecked="CursorCheck_Unchecked"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            x:Name="CursorPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="光标1" FontWeight="Bold" Foreground="#FFEB3B"/>
                            <TextBlock x:Name="Cursor1FreqText" Text="频率: 0.0 Hz" Margin="0,2"/>
                            <TextBlock x:Name="Cursor1MagText" Text="幅值: 0.0 dB" Margin="0,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="光标2" FontWeight="Bold" Foreground="#00BCD4"/>
                            <TextBlock x:Name="Cursor2FreqText" Text="频率: 0.0 Hz" Margin="0,2"/>
                            <TextBlock x:Name="Cursor2MagText" Text="幅值: 0.0 dB" Margin="0,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="差值" FontWeight="Bold" Foreground="#4CAF50"/>
                            <TextBlock x:Name="CursorDeltaFreqText" Text="Δ频率: 0.0 Hz" Margin="0,2"/>
                            <TextBlock x:Name="CursorDeltaMagText" Text="Δ幅值: 0.0 dB" Margin="0,2"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="Cursor1Slider" Margin="0,8,0,0"
                            ValueChanged="Cursor1Slider_ValueChanged"/>
                    <Slider x:Name="Cursor2Slider" Margin="0,4,0,0" Value="50"
                            ValueChanged="Cursor2Slider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 峰值列表 -->
        <GroupBox Header="峰值列表" Grid.Row="3">
            <ListView x:Name="PeakList" Height="80" Background="#2A2A3E" Foreground="#E0E0E8"
                      BorderBrush="#4A4A5A">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="序号" Width="50" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="频率(Hz)" Width="100" DisplayMemberBinding="{Binding Frequency}"/>
                        <GridViewColumn Header="幅值(dB)" Width="100" DisplayMemberBinding="{Binding Magnitude}"/>
                        <GridViewColumn Header="阶次" Width="80" DisplayMemberBinding="{Binding Order}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="重置为默认" Click="ResetDefault_Click"/>
            <Button Content="取消" Click="Cancel_Click"/>
            <Button Content="应用" Click="Apply_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
