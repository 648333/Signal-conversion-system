<Window x:Class="DH.Shell.Views.ChannelConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通道配置" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="BorderBrush" Value="#4A4A5A"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#1A1A2A"/>
            <Setter Property="AlternatingRowBackground" Value="#222233"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- 顶部采样率配置 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="采样率:" Foreground="#E0E0E8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SampleRateCombo" Width="120" SelectedIndex="6"
                      SelectionChanged="SampleRate_Changed">
                <ComboBoxItem Content="10 Hz" Tag="10"/>
                <ComboBoxItem Content="20 Hz" Tag="20"/>
                <ComboBoxItem Content="50 Hz" Tag="50"/>
                <ComboBoxItem Content="100 Hz" Tag="100"/>
                <ComboBoxItem Content="200 Hz" Tag="200"/>
                <ComboBoxItem Content="500 Hz" Tag="500"/>
                <ComboBoxItem Content="1 kHz" Tag="1000"/>
                <ComboBoxItem Content="2 kHz" Tag="2000"/>
                <ComboBoxItem Content="5 kHz" Tag="5000"/>
                <ComboBoxItem Content="10 kHz" Tag="10000"/>
                <ComboBoxItem Content="20 kHz" Tag="20000"/>
                <ComboBoxItem Content="50 kHz" Tag="50000"/>
                <ComboBoxItem Content="100 kHz" Tag="100000"/>
                <ComboBoxItem Content="200 kHz" Tag="200000"/>
                <ComboBoxItem Content="500 kHz" Tag="500000"/>
                <ComboBoxItem Content="1 MHz" Tag="1000000"/>
            </ComboBox>

            <TextBlock Text="通道数:" Foreground="#E0E0E8" VerticalAlignment="Center" Margin="24,0,8,0"/>
            <TextBox x:Name="ChannelCountText" Width="40" Text="8" VerticalAlignment="Center"
                     PreviewTextInput="NumberOnly_Preview"/>

            <Button Content="应用通道数" Width="80" Margin="8,0,0,0" Click="ApplyChannelCount_Click"
                    Background="#2B5C8A" Foreground="White"/>

            <TextBlock Text="已启用:" Foreground="#E0E0E8" VerticalAlignment="Center" Margin="24,0,8,0"/>
            <TextBlock x:Name="ActiveCountText" Text="0" Foreground="#4CAF50" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="全选" Width="60" Margin="0,0,8,0" Click="SelectAll_Click" Background="#3A3A52" Foreground="White"/>
            <Button Content="全不选" Width="60" Margin="0,0,8,0" Click="SelectNone_Click" Background="#3A3A52" Foreground="White"/>
            <Button Content="确定" Width="70" Margin="0,0,8,0" Click="OK_Click" Background="#2B5C8A" Foreground="White"/>
            <Button Content="取消" Width="70" Click="Cancel_Click" Background="#3A3A52" Foreground="White"/>
        </StackPanel>

        <!-- 通道列表 -->
        <DataGrid x:Name="ChannelGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column"
                  MouseDoubleClick="ChannelGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用" Width="50" Binding="{Binding Enabled}"/>
                <DataGridTextColumn Header="通道" Width="50" Binding="{Binding Index}" IsReadOnly="True"/>
                <DataGridTextColumn Header="名称" Width="100" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="类型" Width="80" Binding="{Binding ChannelTypeDisplay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="传感器" Width="100" Binding="{Binding SensorModel}"/>
                <DataGridTextColumn Header="量程" Width="80" Binding="{Binding Range}"/>
                <DataGridTextColumn Header="单位" Width="50" Binding="{Binding Unit}"/>
                <DataGridTextColumn Header="灵敏度" Width="80" Binding="{Binding Sensitivity}"/>
                <DataGridTextColumn Header="采样率" Width="80" Binding="{Binding SampleRateDisplay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="状态" Width="60" Binding="{Binding StatusDisplay}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
